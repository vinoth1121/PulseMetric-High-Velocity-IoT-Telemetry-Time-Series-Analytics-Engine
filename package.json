{
  "name": "pulsemetric",
  "version": "1.0.0",
  "description": "High-Velocity IoT Telemetry & Time-Series Analytics Engine on MongoDB",
  "main": "dist/api/server.js",
  "type": "module",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm run build --prefix web",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/src/api/server.js",
    "dev:server": "tsx watch src/api/server.ts",
    "dev:web": "npm run dev --prefix web",
    "init-db": "tsx scripts/init-db.ts",
    "seed-history": "tsx scripts/seed-history.ts",
    "simulate": "tsx scripts/simulate.ts",
    "rollup": "tsx src/jobs/rollup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:all": "tsx scripts/bench-all.ts",
    "bench:throughput": "tsx scripts/bench-throughput.ts",
    "bench:query-plans": "tsx scripts/bench-query-plans.ts",
    "bench:storage": "tsx scripts/bench-storage.ts",
    "bench:router": "tsx scripts/bench-router.ts",
    "bench:late": "tsx scripts/bench-late.ts",
    "generate-benchmarks": "tsx scripts/generate-benchmarks-md.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongodb": "^6.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.3",
    "autocannon": "^7.15.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.13.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "iot",
    "timeseries",
    "mongodb",
    "telemetry",
    "analytics",
    "densify",
    "setWindowFields"
  ],
  "author": "PulseMetric Team",
  "license": "MIT"
}
